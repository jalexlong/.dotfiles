#!/usr/bin/env python3
"""tmux-move-pane -- move the focused pane one step, the way a tiling WM does.

    tmux-move-pane left|right|up|down

Modelled on COSMIC's Move(Direction), Super+Shift+HJKL on Pop!_OS, and on i3's
tree_move underneath it. The pane takes ONE step through the layout tree and
the rest of the layout closes up behind it. Bound to M-HJKL: Shift on the very
keys that move the focus.

WHY A TREE AND NOT tmux's OWN COMMANDS
--------------------------------------
An earlier version drove swap-pane and join-pane and never parsed a layout.
That is simpler, but join-pane MERGES: splitting a cell whose parent already
runs that way appends to the parent instead of nesting, so layouts flatten as
panes move and nesting can never be preserved. Rewriting the layout string has
no such bias -- tmux accepts and keeps an `h` nested directly inside an `h`, a
shape it would never build itself.

Three tmux frictions shape everything below:

  * select-layout IGNORES the pane ids in the layout string. Cells are filled
    from the window's pane list in order, so applying a tree is only half the
    job; the panes then have to be permuted into their cells. That is settle(),
    and it is the price of this approach.
  * The layout string carries a 16-bit checksum tmux verifies. checksum().
  * Panes have a minimum size, so deep nesting eventually cannot be built at
    all. Alternating splits top out near 6 levels in an 80x24 window and 10 in
    a 300x80 one; past that tmux refuses, and so do we -- see distribute().

Layout strings are a tree of cells. A leaf is `WxH,X,Y,pane`; `{...}` holds
children side by side, `[...]` holds them stacked. Siblings are separated by a
one-character divider, so n children of a W-wide row satisfy
sum(widths) + (n-1) == W. Every routine here maintains that.

THE MOVE
--------
First ask the cheap question: is there a pane right there, sitting in a slot
the same shape as ours? If so the two simply trade places and nothing else on
screen moves at all. That one case covers most of what a move means in
practice -- including a grid, where the panes are cousins in different columns
rather than siblings, and where restructuring instead would dissolve the grid
and resize every pane in it.

Otherwise walk up for the nearest ancestor whose parent runs along the axis of
travel AND that has something on that side. What turns up decides it:

  swap      a pane alongside us in an interchangeable slot: the two exchange,
            every cell stays exactly where it was. tmux does this one itself.
  reorder   a sibling in our own row: they change order. Sizes travel WITH the
            panes here, so a pane keeps its width as it moves along the row --
            which swap-pane cannot do.
  descend   a container that way: the pane joins it as a member, beside
            whichever child it is closest to. Entering it, rather than being
            shoved past it, is what stops a move overshooting.
  pop out   a plain pane that way, but we had to climb to find it: the pane
            leaves its own container and lands beside it ONE level up.
  band      nothing runs that way at all, so create the split -- a new root
            with the pane as a full-width band (or full-height column) and
            everything else beside it. A pane already spanning that edge is the
            true edge case and does nothing.

SIZES
-----
A move should not re-proportion a layout that was arranged deliberately, so:

  * A pane arriving somewhere new asks for the share of the screen it already
    had, not a flat half and not an even 1/n (share_span).
  * Room for it comes off every sibling in proportion, and the space a pane
    leaves behind is shared out the same way. Handing it all to the one
    neighbour looks tidier in a single step -- everyone else keeps their exact
    size -- but that neighbour then absorbs the cost of every move through it
    and balloons, squeezing the rest a little further each pass. Sharing keeps
    the survivors' sizes relative to each other and cancels out over repeats.
  * Both directions are floored (floor_span, MIN_SPAN). Pure proportion
    ratchets: a pane squeezed once computes its next share from the squeezed
    size, and repeated moves walk it down to a single unusable line.

Chasing one pane around a five-pane window used to take its neighbours from 39
columns to 7 in a dozen presses. With the above the same cycle is periodic --
the layout returns to exactly where it started.

Same-orientation nesting is flattened after each move. That never changes what
is on screen -- {A,{B,C}} and {A,B,C} are the same picture -- but it stops a
pane accreting dead layers that would silently change where a later move goes.
i3 does the same.
"""
import subprocess
import sys

# axis of travel, and which way along it. 'h' cells hold children side by side.
# Smallest pane a split will produce while the container can afford it.
MIN_SPAN = 3

DIRECTIONS = {
    "left":  ("h", -1),
    "right": ("h", +1),
    "up":    ("v", -1),
    "down":  ("v", +1),
}


def tmux(*args, check=True):
    r = subprocess.run(("tmux",) + args, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "tmux failed")
    return r.stdout.rstrip("\n")


def checksum(body):
    """tmux's layout_checksum: rotate right one, then add, over the body."""
    c = 0
    for ch in body.encode():
        c = ((c >> 1) + ((c & 1) << 15)) & 0xFFFF
        c = (c + ch) & 0xFFFF
    return f"{c:04x}"


class Cell:
    __slots__ = ("kind", "w", "h", "x", "y", "children", "pane", "parent")

    def __init__(self, w=0, h=0, x=0, y=0, kind="leaf", pane=None):
        self.kind = kind          # "leaf" | "h" (side by side) | "v" (stacked)
        self.w, self.h, self.x, self.y = w, h, x, y
        self.children = []
        self.pane = pane
        self.parent = None

    # Size along the parent's axis: width inside a row, height inside a stack.
    def span(self):
        return self.w if self.parent and self.parent.kind == "h" else self.h

    def set_span(self, n):
        if self.parent and self.parent.kind == "h":
            self.w = n
        else:
            self.h = n

    def leaves(self):
        if self.kind == "leaf":
            yield self
            return
        for c in self.children:
            yield from c.leaves()

    def dump(self):
        head = f"{self.w}x{self.h},{self.x},{self.y}"
        if self.kind == "leaf":
            return f"{head},{self.pane}"
        open_, close = ("{", "}") if self.kind == "h" else ("[", "]")
        return head + open_ + ",".join(c.dump() for c in self.children) + close


class Parser:
    def __init__(self, s):
        self.s, self.i = s, 0

    def peek(self):
        return self.s[self.i] if self.i < len(self.s) else ""

    def number(self):
        start = self.i
        while self.i < len(self.s) and self.s[self.i].isdigit():
            self.i += 1
        return int(self.s[start:self.i])

    def expect(self, ch):
        if self.peek() != ch:
            raise ValueError(f"expected {ch!r} at {self.i} in {self.s!r}")
        self.i += 1

    def cell(self):
        w = self.number(); self.expect("x")
        h = self.number(); self.expect(",")
        x = self.number(); self.expect(",")
        y = self.number()
        cell = Cell(w, h, x, y)
        nxt = self.peek()
        if nxt in ("{", "["):
            cell.kind = "h" if nxt == "{" else "v"
            self.i += 1
            while True:
                child = self.cell()
                child.parent = cell
                cell.children.append(child)
                if self.peek() != ",":
                    break
                self.i += 1
            self.expect("}" if nxt == "{" else "]")
        elif nxt == ",":
            self.i += 1
            cell.pane = self.number()
        return cell


def parse(layout):
    return Parser(layout.split(",", 1)[1]).cell()


# --- geometry -------------------------------------------------------------
#
# Sizes are integers that must add up exactly, so every split is a proportional
# share plus an explicit pass to spend the rounding. A pane cannot be thinner
# than one cell, which is where a layout too deep to build gets refused.

def distribute(total, weights):
    """Split `total` into len(weights) integers >= 1, proportional to weights."""
    n = len(weights)
    if total < n:
        return None                      # not even one cell each: unbuildable
    # Hold everything at a few cells wherever the container can afford it. A
    # 1-cell pane is legal and useless, and squeezing repeatedly is how one
    # appears; below this the split is genuinely too tight and 1 is all there
    # is to give.
    lo = MIN_SPAN if total >= MIN_SPAN * n else 1
    base = sum(weights)
    if base <= 0:
        out = [total // n] * n
    else:
        out = [max(lo, round(total * w / base)) for w in weights]
    drift = total - sum(out)
    guard = 0
    while drift and guard < 1000:
        for i in range(n):
            if not drift:
                break
            if drift > 0:
                out[i] += 1
                drift -= 1
            elif out[i] > lo:
                out[i] -= 1
                drift += 1
        guard += 1
    return None if drift else out


def resize(cell, w, h):
    """Set a cell's box, rescaling its subtree proportionally to fit."""
    cell.w, cell.h = w, h
    if cell.kind == "leaf":
        return True
    n = len(cell.children)
    wide = cell.kind == "h"
    sizes = distribute((w if wide else h) - (n - 1),
                       [c.w if wide else c.h for c in cell.children])
    if sizes is None:
        return False
    for child, size in zip(cell.children, sizes):
        if not resize(child, size if wide else w, h if wide else size):
            return False
    return True


def relayout(cell):
    """Recompute absolute positions once every size is settled."""
    if cell.kind == "leaf":
        return
    offset = cell.x if cell.kind == "h" else cell.y
    for child in cell.children:
        if cell.kind == "h":
            child.x, child.y = offset, cell.y
            offset += child.w + 1
        else:
            child.x, child.y = cell.x, offset
            offset += child.h + 1
        relayout(child)


def flatten(cell):
    """Splice a child into its parent when both run the same way.

    The sizes already agree -- the inner cell's width is exactly its children's
    widths plus their dividers -- so only the tree shape changes, and keeping
    the flat one means a later move sees the panes as the siblings they look
    like on screen.
    """
    if cell.kind == "leaf":
        return
    i = 0
    while i < len(cell.children):
        child = cell.children[i]
        if child.kind == cell.kind:
            for grand in child.children:
                grand.parent = cell
            cell.children[i:i + 1] = child.children
        else:
            flatten(child)
            i += 1


# --- structural edits -----------------------------------------------------

def detach(node, root):
    """Remove a leaf, share its space out proportionally, return the root.

    Proportionally, and not to the one neighbour it was sitting next to. That
    looks tempting -- every other pane keeps its exact size -- but it is the
    one that wrecks a layout over time: the same neighbour absorbs the gap on
    every pass, so it balloons while everything else is squeezed to make room
    for it, and a pane chased around the window walks its neighbours down from
    39 columns to 7. Sharing it out keeps the RELATIVE sizes of the survivors
    exactly as they were, and gives and takes that cancel out over repeated
    moves instead of accumulating.

    A container left holding one child is replaced by that child; otherwise the
    tree fills up with one-child cells that no longer mean anything.
    """
    parent = node.parent
    parent.children.remove(node)
    node.parent = None

    if len(parent.children) > 1:
        return root if resize(parent, parent.w, parent.h) else None

    survivor = parent.children[0]
    grand = parent.parent
    survivor.parent = grand
    if not resize(survivor, parent.w, parent.h):
        return None
    if grand is None:
        return survivor
    grand.children[grand.children.index(parent)] = survivor
    return root


def share_span(node, container):
    """How big should `node` be once it is inside `container`?

    Its share of the screen, kept. A pane that filled a third of the window
    still fills about a third after it moves, instead of being handed a flat
    half or an even 1/n -- which is what made a move visibly re-proportion
    everything around it.
    """
    span = container.w if container.kind == "h" else container.h
    n = len(container.children)
    room = span - 2 * n                          # every sibling keeps >= 1
    if room < 1:
        return 1
    total = container.w * container.h + node.w * node.h
    frac = (node.w * node.h) / total if total else 0.5
    return max(1, min(room, max(round(span * frac), floor_span(span, n + 1))))


def floor_span(span, parts):
    """The smallest share a moving pane may be given.

    Pure proportion ratchets: a pane that gets squeezed once computes its next
    share from the size it was squeezed to, so moving it repeatedly walks it
    down to a single line and it can never recover. Holding it at half an even
    share bounds that -- proportions still decide anything above the floor,
    but the sequence converges instead of collapsing.
    """
    return max(2, (span // max(1, parts)) // 2)


def insert(parent, index, node):
    """Add a cell, making room proportionally across the container.

    The newcomer asks for the share of the screen it already had (share_span)
    rather than a flat half or an even 1/n, and the room for it comes off
    every existing child in proportion -- so they keep their sizes relative to
    each other and only lose a little each. Taking it all from the one pane
    being displaced is the same trap detach() describes: it singles out one
    neighbour to pay for every move.
    """
    wide = parent.kind == "h"
    want = share_span(node, parent)
    node.parent = parent
    if wide:
        node.w, node.h = want, parent.h
    else:
        node.w, node.h = parent.w, want
    parent.children.insert(index, node)
    return resize(parent, parent.w, parent.h)


# --- the move -------------------------------------------------------------

def spans_edge(me, root, axis, sign):
    """Already the full band on the side we are moving toward?

    Then there is nowhere further to go. Rebuilding an identical band would not
    look like a move -- it would just reset a hand-resized layout to an even
    split.
    """
    if axis == "v":
        if me.w != root.w or me.x != root.x:
            return False
        return me.y == root.y if sign < 0 else me.y + me.h == root.y + root.h
    if me.h != root.h or me.y != root.y:
        return False
    return me.x == root.x if sign < 0 else me.x + me.w == root.x + root.w


def nearest_child(container, me):
    """Where in a perpendicular container does the pane belong?

    i3 inserts next to the container's focused child. tmux has one active pane
    per window and no per-container focus history, so that cannot be
    reproduced; this approximates it with the child the pane is physically
    closest to, which is what it looks like from the outside anyway.
    """
    if container.kind == "h":
        centre = me.x + me.w / 2
        mids = [c.x + c.w / 2 for c in container.children]
    else:
        centre = me.y + me.h / 2
        mids = [c.y + c.h / 2 for c in container.children]
    best = min(range(len(mids)), key=lambda i: abs(mids[i] - centre))
    return best + (1 if centre > mids[best] else 0)


def adjacent(me, root, axis, sign):
    """The pane whose cell touches ours on that side, sharing the most edge."""
    best, most = None, 0
    for leaf in root.leaves():
        if leaf is me:
            continue
        if axis == "h":
            touching = (leaf.x + leaf.w + 1 == me.x if sign < 0
                        else me.x + me.w + 1 == leaf.x)
            overlap = min(leaf.y + leaf.h, me.y + me.h) - max(leaf.y, me.y)
        else:
            touching = (leaf.y + leaf.h + 1 == me.y if sign < 0
                        else me.y + me.h + 1 == leaf.y)
            overlap = min(leaf.x + leaf.w, me.x + me.w) - max(leaf.x, me.x)
        if touching and overlap > most:
            best, most = leaf, overlap
    return best


def congruent(a, b, axis):
    """Do these two cells occupy interchangeable slots?

    Interchangeable across the axis of travel: same top and bottom for a
    sideways move, same left and right for a vertical one. Two such panes can
    trade places with nothing else on screen moving at all.
    """
    if axis == "h":
        return a.y == b.y and a.h == b.h
    return a.x == b.x and a.w == b.w


def plan(me, root, axis, sign):
    """Which step applies. Always (kind, cell, index, index)."""
    # 1. Is there a pane right there, in a slot the same shape as ours? Then
    #    the two just trade places and NOTHING else changes -- no cell moves,
    #    no ratio is touched. This is what keeps a grid a grid. Siblings are
    #    left to "reorder" below, which carries their sizes along with them
    #    instead of swapping panes between fixed slots.
    other = adjacent(me, root, axis, sign)
    if (other is not None and congruent(me, other, axis)
            and not (other.parent is me.parent and me.parent.kind == axis)):
        return ("swap", other, None, None)

    # 2. Otherwise walk up for the nearest ancestor that runs the way we are
    #    going and has something on that side.
    cur = me
    while cur.parent is not None:
        parent = cur.parent
        if parent.kind == axis:
            i = parent.children.index(cur)
            j = i + sign
            if 0 <= j < len(parent.children):
                target = parent.children[j]
                # A container next door is entered, not shoved past -- even
                # when we had to climb to find it. Popping out is for when the
                # thing that way is a plain pane, and it was popping out in
                # both cases that made moves feel like they went too far.
                if target.kind != "leaf":
                    return ("descend", target, None, None)
                if cur is me:
                    return ("reorder", parent, i, j)
                return ("out", parent, i if sign < 0 else i + 1, None)
        cur = parent
    return ("band", None, None, None)


def apply_move(me, root, axis, sign):
    """Work out and perform the step.

    Returns ("swap", other_leaf) for a straight exchange of two panes, which
    needs no new layout at all, or ("tree", root) for a structural change, or
    (None, None) when there is nowhere to go.
    """
    kind, cell, i, j = plan(me, root, axis, sign)

    if kind == "swap":
        return "swap", cell

    if kind == "reorder":
        # Sizes travel with the panes here: a pane keeps its width as it moves
        # along its own row, which is what a tiling WM does and what swap-pane
        # cannot. The row's set of widths is unchanged, they just move.
        cell.children[i], cell.children[j] = cell.children[j], cell.children[i]
        return "tree", root

    if kind == "descend":
        # Where to land is decided BEFORE detaching, while the pane still has
        # the geometry that says which child it is closest to.
        index = (0 if sign > 0 else len(cell.children)) \
            if cell.kind == axis else nearest_child(cell, me)
        root = detach(me, root)
        if root is None:
            return None, None
        placed = insert(cell, min(index, len(cell.children)), me)
        return ("tree", root) if placed else (None, None)

    if kind == "out":
        root = detach(me, root)
        if root is None:
            return None, None
        placed = insert(cell, min(i, len(cell.children)), me)
        return ("tree", root) if placed else (None, None)

    # band: nothing in the tree runs that way, so make the tree run that way.
    if spans_edge(me, root, axis, sign):
        return None, None
    # Take the share of the screen the pane already had rather than a flat
    # half. Promoting one of three columns to a full-width band should cost
    # the other two a third of their height, not half of it.
    whole = root.w * root.h
    frac = (me.w * me.h) / whole if whole else 0.5
    root = detach(me, root)
    if root is None:
        return None, None
    band = Cell(root.w, root.h, root.x, root.y, kind=axis)
    span = band.w if axis == "h" else band.h
    mine = max(1, min(span - 2, max(round(span * frac), floor_span(span, 2))))
    me.parent = band
    root.parent = band
    band.children = [me, root] if sign < 0 else [root, me]
    me.set_span(mine)
    root.set_span(span - mine - 1)
    return ("tree", band) if resize(band, band.w, band.h) else (None, None)


def settle(want):
    """Put each pane in the cell the new tree gave it.

    select-layout fills cells from the window's pane list in order and ignores
    the ids in the layout string, so the panes have to be permuted into place
    afterwards. swap-pane exchanges two panes' cells and their list positions
    together, so a selection sort gets there in at most n-1 swaps.
    """
    have = tmux("list-panes", "-F", "#{pane_id}").splitlines()
    at = {pane: i for i, pane in enumerate(have)}
    for k, pane in enumerate(want):
        if k >= len(have) or have[k] == pane:
            continue
        j = at[pane]
        tmux("swap-pane", "-d", "-s", have[k], "-t", have[j])
        at[have[k]], at[have[j]] = j, k
        have[k], have[j] = have[j], have[k]


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in DIRECTIONS:
        name = sys.argv[0].rsplit("/", 1)[-1]
        print(f"usage: {name} {{{'|'.join(DIRECTIONS)}}}", file=sys.stderr)
        return 2
    axis, sign = DIRECTIONS[sys.argv[1]]

    me_id, zoomed, count = tmux(
        "display", "-p",
        "#{pane_id} #{window_zoomed_flag} #{window_panes}").split()
    if int(count) < 2:
        return 0

    # A zoomed pane is the only one on screen and reports the whole window as
    # its geometry, so unzoom to work and zoom back however this exits -- a
    # tiling WM keeps a fullscreen window fullscreen when it moves it.
    if zoomed == "1":
        tmux("resize-pane", "-Z", "-t", me_id)
    try:
        root = parse(tmux("display", "-p", "#{window_layout}"))
        me = next((c for c in root.leaves() if f"%{c.pane}" == me_id), None)
        if me is None:
            return 0

        mode, result = apply_move(me, root, axis, sign)
        if mode is None:
            return 0                     # at the edge, or too small to build

        if mode == "swap":
            # Two interchangeable slots: tmux can exchange the panes itself,
            # which leaves every cell exactly where it was.
            tmux("swap-pane", "-d", "-s", me_id, "-t", f"%{result.pane}")
            tmux("select-pane", "-t", me_id)
            return 0

        root = result
        root.parent = None
        flatten(root)
        relayout(root)

        body = root.dump()
        try:
            tmux("select-layout", f"{checksum(body)},{body}")
        except RuntimeError:
            # tmux validates the sizes as well as the checksum. A layout it
            # will not take means the move does not fit, not that we crash.
            return 0
        settle([f"%{leaf.pane}" for leaf in root.leaves()])
        tmux("select-pane", "-t", me_id)
    finally:
        if zoomed == "1":
            tmux("resize-pane", "-Z", "-t", me_id, check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
